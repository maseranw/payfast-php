{
    "name": "ngelekanyo/payfast",
    "description": "PayFast subscription toolkit for PHP: signature generation/verification, ITN handling, and a Laravel integration layer",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ngelekanyo Masera",
            "email": "ngelekanyo@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.5",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0",
        "illuminate/routing": "^9.0 || ^10.0 || ^11.0",
        "illuminate/http": "^9.0 || ^10.0 || ^11.0"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel service provider and routes",
        "guzzlehttp/guzzle": "Required for outbound HTTP calls to PayFast's API"
    },
    "autoload": {
        "psr-4": {
            "Ngelekanyo\\Payfast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ngelekanyo\\Payfast\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ngelekanyo\\Payfast\\Laravel\\PayfastServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
